WEBAUTHN_RP_ID=webauthn.dkackman.com
WEBAUTHN_RP_ORIGIN=https://webauthn.dkackman.com/

# Android sends `android:apk-key-hash:<base64url(SHA-256(signing cert))>` as the
# WebAuthn origin instead of the web origin, so the verifier has to allow it too.
# It must match the cert in the RP's assetlinks.json. Defaults to the standard
# Android debug keystore (the value below). See README.md for how to derive it.
# PASSKEY_APK_KEY_HASH=android:apk-key-hash:ACDefg1Oe_Oghhc1udjQbgeC9Za9h_fyf9vjJaBx-VI
