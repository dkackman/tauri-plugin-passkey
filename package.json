{
  "name": "tauri-plugin-passkey-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri Plugin Passkey - Monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "install:all": "pnpm install",
    "test": "pnpm -r test",
    "test:js": "cd tauri-plugin-passkey && pnpm test:js",
    "test:rust": "cd tauri-plugin-passkey && cargo test",
    "test:swift": "cd tauri-plugin-passkey && pnpm test:swift",
    "test:android": "cd tauri-plugin-passkey/android && (./gradlew test || gradle test || echo 'Note: Gradle wrapper not found. Install Gradle or run from Android Studio')",
    "test:android:instrumented": "cd tauri-plugin-passkey/android && (./gradlew connectedAndroidTest || gradle connectedAndroidTest || echo 'Note: Gradle wrapper not found. Install Gradle or run from Android Studio')",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "format:js": "pnpm -r format:js",
    "format:rust": "pnpm -r format:rust",
    "format:swift": "pnpm -r format:swift",
    "format:kotlin": "pnpm -r format:kotlin",
    "lint": "pnpm -r lint",
    "lint:js": "pnpm -r lint:js",
    "lint:rust": "pnpm -r lint:rust",
    "lint:swift": "pnpm -r lint:swift",
    "lint:kotlin": "pnpm -r lint:kotlin"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
